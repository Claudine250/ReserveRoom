<UserControl x:Class="ReserveRoom.Views.MakeReservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReserveRoom.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Grid.IsSharedSizeScope="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>


        <TextBlock 
            Grid.Row="0"
            Text="Make Reservation"  
            Style="{StaticResource Header}"/>


        <Grid Grid.Row="1" Margin="0 25 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Username" />
            <TextBox 
                Grid.Row ="1"
                Margin=" 0 5 0 0"
                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />


            <Grid Grid.Row="2" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />

                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="70"
                    HorizontalAlignment="Left"
                    Text="Floor No." />
                <TextBox 
                    Grid.Row ="1"
                    Grid.Column ="0"
                    Width="100"
                    HorizontalAlignment="Left" 
                    Text="{Binding FloorNumber, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1" 
                    Margin=" -100 0 0 0"
                    Text="Room No" />

                <TextBox 
                    Grid.Row ="1"
                    Grid.Column ="1"
                    Width="80"
                    Margin=" -120 0 0 0"
                    Text="{Binding RoomNumber,  UpdateSourceTrigger=PropertyChanged}" />



                <Grid Grid.Row="3" Margin="0 5 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0" 
                        Margin ="0 5 0 0"
                        Text="Start Date" />
                    <DatePicker 
                        Grid.Row ="1"
                        Grid.Column ="0"
                        Width="100"
                        SelectedDate="{Binding StartDate,  UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1" 
                        Margin="20 5 0 0"
                        Text="End Date" />

                    <DatePicker
                        Grid.Row ="1"
                        Grid.Column ="1"
                        Margin=" 20 0 0 0"
                        SelectedDate="{Binding EndDate,  UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <StackPanel Grid.Row="4" Margin="0,5,0,0" Orientation="Horizontal" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="248" >
                    <Button Margin="5 10 0 0 " Background="Green" Content="Submit" Command="{Binding SubmitCommand}"/>
                    <Button Margin="5 10 0 0 "  BorderBrush="Red" Click="Button_Click" Content="Cancel" Command="{Binding CancelCommand}" />

                </StackPanel>

            </Grid>
        </Grid>
    </Grid>


</UserControl>
